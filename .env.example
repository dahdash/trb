# LLM (Q-003): boxapi, OpenAI-compatible
BOX_API_TOKEN=
LLM_BASE_URL=https://ai.boxapi.ir/ai/v1
LLM_MODEL=gpt-5.4-mini
# 1 = use the LLM (production only, with a cheap model). Unset locally: rule-based assistant, no API calls.
LLM_ENABLED=
# Map (Q-005)
NESHAN_API_KEY=
# web.… key for the browser map (Q-009); without it the map falls back to OSM tiles
NESHAN_WEB_API_KEY=
# Deploy (Q-004), used by ~/Work/liara tooling only
LIARA_API_KEY=
LIARA_TEAM_ID=
# Optional
DB_PATH=data/torob.db
